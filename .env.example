# Prefer your Model Studio workspace's dedicated host, with /api/v1 for the DashScope native embedding API.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RETRIEVAL_CANDIDATE_LIMIT=30
RETRIEVAL_CONTEXT_CHARS=16000
ENABLE_RAG_RERANK=false
