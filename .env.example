POSTGRES_USER=nl2sql
POSTGRES_PASSWORD=nl2sql_dev_password
POSTGRES_DB=nl2sql
POSTGRES_PORT=5432
DB_ADMIN_URL=postgresql://nl2sql:nl2sql_dev_password@localhost:5432/nl2sql
DB_READER_URL=postgresql://nl2sql_reader:reader_dev_password@localhost:5432/nl2sql
DB_READER_PASSWORD=reader_dev_password
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek/deepseek-flash
QWEN_API_KEY=
QWEN_EMBED_MODEL=qwen3.7-text-embedding
