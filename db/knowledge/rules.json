[
  {"id":"rule.order_status","kind":"rule","object_ref":"order_status_rule","aliases":["有效订单","排除取消","订单状态口径"],"related_tables":["orders"],"priority":94,"metadata":{"exclusions":"默认 orders.status <> 'CANCELLED'"},"content":"订单、销量、GMV 等下单口径默认排除 CANCELLED。只有用户明确询问全部创建订单、取消订单或取消率时才包含取消订单。"},
  {"id":"rule.order_time","kind":"rule","object_ref":"order_time_rule","aliases":["下单日期","订单月份","下单时间"],"related_tables":["orders"],"priority":88,"metadata":{"time_column":"orders.ordered_at"},"content":"订单量、GMV、销量和首购默认按 ordered_at 筛选。不要用支付或发货时间代替。"},
  {"id":"rule.payment_status","kind":"rule","object_ref":"payment_status_rule","aliases":["成功支付","支付状态","失败支付排除"],"related_tables":["payments"],"priority":96,"metadata":{"exclusions":"payments.status='SUCCEEDED'"},"content":"收入只认 SUCCEEDED 支付。FAILED 行是支付尝试，不产生收入；同一订单可以有多笔成功分次支付，金额应全部相加。"},
  {"id":"rule.payment_time","kind":"rule","object_ref":"payment_time_rule","aliases":["支付日期","收入月份","到账时间"],"related_tables":["payments"],"priority":94,"metadata":{"time_column":"payments.paid_at"},"content":"销售额、支付订单数等收入口径按 paid_at 筛选成功支付。不要使用 attempted_at 或 orders.ordered_at。"},
  {"id":"rule.payment_attempt_time","kind":"rule","object_ref":"payment_attempt_time_rule","aliases":["支付尝试时间","支付失败时间","付款尝试日期"],"related_tables":["payments"],"priority":86,"metadata":{"time_column":"payments.attempted_at"},"content":"支付成功率、失败次数和重试分析按 attempted_at 筛选所有支付尝试；FAILED 的 paid_at 为空。"},
  {"id":"rule.refund_status","kind":"rule","object_ref":"refund_status_rule","aliases":["有效退款","已批准退款","退款状态口径"],"related_tables":["refunds"],"priority":96,"metadata":{"exclusions":"只计 refunds.status='APPROVED'"},"content":"实际退款金额和退货件数只统计 APPROVED。PENDING 是处理中，REJECTED 是拒绝，不得计入实际退款。"},
  {"id":"rule.refund_request_time","kind":"rule","object_ref":"refund_request_time_rule","aliases":["退款申请日期","申请退款时间"],"related_tables":["refunds"],"priority":84,"metadata":{"time_column":"refunds.requested_at"},"content":"退款申请量和申请原因分析按 requested_at；它不等同于实际退款完成时间。"},
  {"id":"rule.refund_completion_time","kind":"rule","object_ref":"refund_completion_time_rule","aliases":["退款完成日期","退款到账日期","实际退款时间"],"related_tables":["refunds"],"priority":88,"metadata":{"time_column":"refunds.refunded_at"},"content":"按实际退款发生期统计退款流出时，筛 APPROVED 并使用 refunded_at。"},
  {"id":"rule.net_sales_window","kind":"rule","object_ref":"net_sales_window_rule","aliases":["净销售额时间窗口","跨月退款","退款后收入窗口"],"related_tables":["payments","refunds"],"priority":98,"content":"默认净销售额是支付 cohort 口径：先按 paid_at 选择成功支付订单，再扣这些订单最终全部已批准退款，即使退款晚于支付窗口。若用户明确问当期现金净流入，则用当期成功支付减当期 refunded_at 的退款。"},
  {"id":"rule.month_half_open","kind":"rule","object_ref":"month_half_open_interval","aliases":["月份范围","月初月末","时间边界"],"related_tables":["orders","payments","refunds","web_sessions"],"priority":88,"content":"月份和日期区间统一使用 >= 起点 AND < 下一周期起点的半开区间，避免月底天数、毫秒和时区边界错误。"},
  {"id":"rule.business_timezone","kind":"rule","object_ref":"business_timezone","aliases":["业务时区","北京时间","UTC转换"],"related_tables":["orders","payments","refunds","shipments","web_sessions"],"priority":88,"content":"数据库 timestamptz 样例值以 UTC 存储，默认业务自然日按 Asia/Shanghai 解释。按中国自然日分组时使用 timestamp AT TIME ZONE 'Asia/Shanghai' 后再取日期；显式 UTC 问题除外。"},
  {"id":"rule.registration_time","kind":"rule","object_ref":"registration_time_rule","aliases":["注册时间","新增用户日期"],"related_tables":["customers"],"priority":84,"metadata":{"time_column":"customers.signup_at"},"content":"注册用户分析按 signup_at，与首次下单时间无关。"},
  {"id":"rule.repeat_purchase_window","kind":"rule","object_ref":"repeat_purchase_window_rule","aliases":["复购窗口","复购周期","窗口复购"],"related_tables":["orders"],"priority":88,"content":"未指定观察期时，复购率只比较同一查询窗口内的有效订单次数。若问首购后 30 天或次月复购，必须按明确 cohort 与观察窗口计算。"},
  {"id":"rule.membership_snapshot","kind":"rule","object_ref":"membership_order_snapshot","aliases":["会员等级快照","历史等级","下单时会员"],"related_tables":["orders","customer_memberships"],"priority":98,"content":"历史订单按 orders.membership_tier_code 读取下单时会员等级。customer_memberships.valid_to IS NULL 仅代表现在的等级，用它回连历史订单会把升级前订单错误归到新等级。"},
  {"id":"rule.membership_effective_interval","kind":"rule","object_ref":"membership_effective_interval","aliases":["会员生效区间","等级有效期","会员有效时间"],"related_tables":["customer_memberships"],"priority":92,"content":"会员历史采用半开有效期：valid_from <= 时点 AND (valid_to IS NULL OR 时点 < valid_to)。相邻等级在切换时刻不会同时有效。"},
  {"id":"rule.membership_discount_order","kind":"rule","object_ref":"membership_discount_order","aliases":["会员折扣顺序","折上折","会员优惠计算"],"related_tables":["membership_tiers","order_items"],"priority":98,"content":"样例业务先计算活动折扣，再对活动后单价计算会员折扣。order_items.membership_discount_amount 已保存实际会员让利，unit_price 已同时扣除活动和会员优惠；不要从支付金额再次扣减。"},
  {"id":"rule.membership_shipping","kind":"rule","object_ref":"membership_shipping_rule","aliases":["会员免运费","白金包邮","钻石包邮"],"related_tables":["orders"],"priority":82,"content":"种子业务中白金和钻石会员订单免基础运费，普通和黄金会员仍可能因其他免邮条件得到 0 运费。判断实际运费应使用 orders.shipping_fee，不能只按等级推断。"},
  {"id":"rule.campaign_attribution","kind":"rule","object_ref":"campaign_attribution_rule","aliases":["活动归因","营销归因","促销订单认定"],"related_tables":["campaigns","order_promotions","orders"],"priority":94,"content":"订单是否归因活动以 order_promotions 记录为准。订单发生在活动日期内不代表参加活动；活动日期只用于活动有效期与费用窗口。"},
  {"id":"rule.discount_not_double_count","kind":"rule","object_ref":"discount_not_double_count","aliases":["优惠重复扣减","折扣重复计算","成交价口径"],"related_tables":["order_items","payments"],"priority":94,"content":"order_items.unit_price 已是最终成交单价，payments.amount 也已反映商品折扣。campaign_discount_amount 和 membership_discount_amount 用于解释让利，不应再从 unit_price 或支付金额中扣减。"},
  {"id":"rule.delivery_status","kind":"rule","object_ref":"delivery_status_rule","aliases":["已送达包裹","妥投状态","物流状态"],"related_tables":["shipments"],"priority":86,"content":"送达时效只在 status='DELIVERED' 且 delivered_at 非空的包裹上计算。PENDING、SHIPPED 和 LOST 不进入已送达分母，除非问题问未送达或丢失率。"},
  {"id":"rule.session_time","kind":"rule","object_ref":"session_time_rule","aliases":["访问日期","流量月份","会话时间"],"related_tables":["web_sessions"],"priority":84,"metadata":{"time_column":"web_sessions.session_started_at"},"content":"会话、流量和会话转化率按 session_started_at 选择窗口。converted_order_id 指向稍后创建的订单，不应用订单时间反筛会话。"},
  {"id":"rule.safe_ratio","kind":"rule","object_ref":"safe_ratio_rule","aliases":["除零","比率计算","百分比"],"related_tables":[],"priority":76,"content":"所有比率使用 numerator / NULLIF(denominator,0)，需要百分数时最终乘 100；NUMERIC 除法优先，避免整数截断。"},
  {"id":"rule.preaggregate_many_to_many","kind":"rule","object_ref":"preaggregate_many_to_many","aliases":["多对多聚合","金额放大","重复计算"],"related_tables":["payments","refunds","shipments","order_promotions"],"priority":96,"content":"两个一对多事实表经同一订单连接前必须分别聚合到 order_id。典型组合包括支付与退款、支付与包裹、支付与活动，否则行数相乘导致金额放大。"}
