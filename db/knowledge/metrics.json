[
  {"id":"metric.order_count","kind":"metric","object_ref":"order_count","aliases":["订单量","订单数","多少单","有效订单数"],"related_tables":["orders"],"required_docs":["rule.order_status","rule.order_time"],"priority":90,"metadata":{"grain":"所选维度","time_column":"orders.ordered_at","formula":"COUNT(DISTINCT orders.order_id)","exclusions":"默认排除 CANCELLED"},"content":"默认订单数按下单时间统计，COUNT(DISTINCT orders.order_id)，排除 CANCELLED。若明确问创建订单总数或取消订单，则按问题调整。"},
  {"id":"metric.paid_order_count","kind":"metric","object_ref":"paid_order_count","aliases":["支付订单数","已支付订单数","付款订单量","成功支付订单"],"related_tables":["payments","orders"],"required_docs":["rule.payment_status","rule.payment_time"],"priority":94,"metadata":{"time_column":"payments.paid_at","formula":"COUNT(DISTINCT payments.order_id) WHERE payments.status='SUCCEEDED'"},"content":"支付订单数是至少有一笔成功支付的不同订单数。必须 COUNT(DISTINCT payments.order_id)，不能统计成功支付行数，因为订单可能分次支付。"},
  {"id":"metric.gross_sales","kind":"metric","object_ref":"gross_sales","aliases":["销售额","实收金额","支付金额","总销售额","支付收入"],"related_tables":["payments"],"required_docs":["rule.payment_status","rule.payment_time"],"priority":94,"metadata":{"time_column":"payments.paid_at","formula":"SUM(payments.amount) WHERE status='SUCCEEDED'","exclusions":"不扣退款"},"content":"总销售额或实收金额默认指成功支付金额之和，不扣退款。分次支付应全部相加，失败支付必须排除。"},
  {"id":"metric.merchandise_gmv","kind":"metric","object_ref":"merchandise_gmv","aliases":["GMV","商品交易总额","商品成交额","含优惠前成交额"],"related_tables":["orders","order_items"],"required_docs":["rule.order_status"],"priority":92,"metadata":{"time_column":"orders.ordered_at","formula":"SUM(order_items.quantity * order_items.list_unit_price)","exclusions":"默认排除取消订单；不含运费，不扣优惠和退款"},"content":"商品 GMV 按下单时标价乘数量汇总，默认排除取消订单，不含运费，不扣活动折扣、会员折扣或退款。它不同于成功支付销售额。"},
  {"id":"metric.net_sales","kind":"metric","object_ref":"net_sales","aliases":["净销售额","净收入","退款后销售额","扣除退款收入"],"related_tables":["payments","refunds","orders"],"required_docs":["rule.payment_status","rule.refund_status","rule.net_sales_window","join.payment_refunds_safe"],"priority":98,"metadata":{"time_column":"payments.paid_at","formula":"所选成功支付订单的 SUM(payment amount)-SUM(approved refund amount)"},"content":"净销售额先按 paid_at 选定成功支付订单，再减去这些订单全部 APPROVED 退款；退款即使发生在所选支付窗口之后也扣除。支付和退款必须分别按 order_id 聚合后再连接。"},
  {"id":"metric.net_merchandise_sales","kind":"metric","object_ref":"net_merchandise_sales","aliases":["净商品收入","商品净收入","扣退款商品销售额"],"related_tables":["order_items","refund_items","refunds","orders"],"required_docs":["rule.refund_status","join.refund_items"],"priority":91,"metadata":{"time_column":"orders.ordered_at","formula":"SUM(quantity*unit_price)-SUM(approved refund_items.amount)","exclusions":"不含运费"},"content":"净商品收入使用订单明细最终成交金额，减去已批准的商品退款金额，不含运费。它不同于以成功支付为基础的净销售额。"},
  {"id":"metric.average_order_value","kind":"metric","object_ref":"average_order_value","aliases":["客单价","平均订单金额","AOV"],"related_tables":["payments"],"required_docs":["metric.gross_sales","metric.paid_order_count"],"priority":90,"metadata":{"formula":"gross_sales / paid_order_count"},"content":"客单价默认等于成功支付金额除以成功支付订单数。分子汇总成功支付行，分母按不同订单计数；不是每客户收入。"},
  {"id":"metric.units_sold","kind":"metric","object_ref":"units_sold","aliases":["销售件数","卖出多少件","销量","商品件数"],"related_tables":["orders","order_items"],"required_docs":["rule.order_status"],"priority":88,"metadata":{"time_column":"orders.ordered_at","formula":"SUM(order_items.quantity)","exclusions":"默认排除取消订单"},"content":"销售件数是订单明细 quantity 之和，默认排除取消订单。它不是明细行数，也不是不同商品数。"},
  {"id":"metric.sku_count","kind":"metric","object_ref":"sku_count","aliases":["SKU数","商品种数","不同商品数","售卖商品数"],"related_tables":["orders","order_items"],"required_docs":["rule.order_status"],"priority":82,"metadata":{"formula":"COUNT(DISTINCT order_items.product_id)"},"content":"售卖 SKU 数按不同 product_id 计数，默认排除取消订单；不要使用 SUM(quantity)。"},
  {"id":"metric.active_customers","kind":"metric","object_ref":"active_customers","aliases":["活跃购买客户","购买人数","下单客户数","活跃客户"],"related_tables":["orders"],"required_docs":["rule.order_status"],"priority":84,"metadata":{"time_column":"orders.ordered_at","formula":"COUNT(DISTINCT orders.customer_id)"},"content":"购买活跃客户默认是在窗口内有至少一张非取消订单的不同客户数。若问题指网站活跃，应改用 web_sessions。"},
  {"id":"metric.new_registered_customers","kind":"metric","object_ref":"new_registered_customers","aliases":["注册新客","新增注册用户","新注册客户"],"related_tables":["customers"],"required_docs":["rule.registration_time"],"priority":85,"metadata":{"time_column":"customers.signup_at","formula":"COUNT(DISTINCT customer_id)"},"content":"注册新客按 signup_at 落在窗口内的客户计数，与首购新客不同，不要求发生订单。"},
  {"id":"metric.first_purchase_customers","kind":"metric","object_ref":"first_purchase_customers","aliases":["首购客户","下单新客","首次购买人数","新买家"],"related_tables":["orders"],"required_docs":["rule.order_status","join.first_purchase"],"priority":90,"metadata":{"time_column":"首次非取消订单的 ordered_at","formula":"每客户 MIN(ordered_at) 后按窗口计数"},"content":"首购客户是其第一张非取消订单发生在窗口内的客户。必须先对全历史订单求每客户首次下单时间，再筛选窗口，不能先筛窗口再 MIN。"},
  {"id":"metric.repeat_purchase_rate","kind":"metric","object_ref":"repeat_purchase_rate","aliases":["复购率","重复购买率","二次购买率"],"related_tables":["orders"],"required_docs":["rule.order_status","rule.repeat_purchase_window"],"priority":92,"metadata":{"formula":"窗口内至少2个有效订单客户数 / 至少1个有效订单客户数"},"content":"默认窗口复购率：窗口内非取消订单数至少 2 的客户数，除以窗口内至少 1 单的客户数。若用户要首购后 N 天复购，需要澄清或按明确周期计算。"},
  {"id":"metric.member_order_count","kind":"metric","object_ref":"member_order_count","aliases":["会员订单数","各等级订单量","黄金会员订单","白金会员订单","钻石会员订单"],"related_tables":["orders","membership_tiers"],"required_docs":["rule.membership_snapshot","metric.order_count"],"priority":94,"metadata":{"formula":"按 orders.membership_tier_code 分组 COUNT(DISTINCT order_id)"},"content":"历史会员订单按 orders.membership_tier_code 快照分组，而不是连接客户当前会员等级。默认排除取消订单。"},
  {"id":"metric.member_sales","kind":"metric","object_ref":"member_sales","aliases":["会员销售额","各会员等级收入","钻石会员销售额","会员贡献"],"related_tables":["orders","payments","membership_tiers"],"required_docs":["rule.membership_snapshot","metric.gross_sales"],"priority":94,"metadata":{"formula":"成功支付按 orders.membership_tier_code 分组求和"},"content":"按会员等级统计历史销售额时，用订单保存的 membership_tier_code 快照连接成功支付，不用 current membership。"},
  {"id":"metric.membership_discount","kind":"metric","object_ref":"membership_discount","aliases":["会员优惠金额","会员折扣金额","等级折扣让利","会员省了多少钱"],"related_tables":["orders","order_items","membership_tiers"],"required_docs":["rule.membership_discount_order","rule.order_status"],"priority":96,"metadata":{"formula":"SUM(order_items.membership_discount_amount)"},"content":"会员优惠金额直接汇总 order_items.membership_discount_amount。该金额已反映在最终 unit_price 中，不能再从支付金额重复扣减。"},
  {"id":"metric.campaign_discount","kind":"metric","object_ref":"campaign_discount","aliases":["活动优惠金额","促销折扣金额","活动让利"],"related_tables":["order_items","order_promotions","orders"],"required_docs":["rule.campaign_attribution","rule.order_status"],"priority":88,"metadata":{"formula":"SUM(order_items.campaign_discount_amount)"},"content":"活动优惠金额可从订单明细 campaign_discount_amount 汇总；按活动拆分时使用 order_promotions.allocated_discount_amount，连接多活动后注意粒度。"},
  {"id":"metric.gross_profit","kind":"metric","object_ref":"gross_profit","aliases":["毛利","商品毛利额","销售毛利"],"related_tables":["orders","order_items"],"required_docs":["rule.order_status"],"priority":90,"metadata":{"formula":"SUM(quantity * (unit_price-cost_unit_price))","exclusions":"默认不含运费、营销费用与退款"},"content":"默认商品毛利使用历史最终成交单价减历史标准成本，再乘数量；排除取消订单，不含运费、广告费和退款影响。若需退款后毛利应明确提出。"},
  {"id":"metric.gross_margin","kind":"metric","object_ref":"gross_margin","aliases":["毛利率","商品毛利率"],"related_tables":["orders","order_items"],"required_docs":["metric.gross_profit"],"priority":88,"metadata":{"formula":"gross_profit / SUM(quantity*unit_price)"},"content":"商品毛利率是商品毛利额除以商品最终成交金额。分母不使用标价 GMV；用 NULLIF 防止除零。"},
  {"id":"metric.payment_success_rate","kind":"metric","object_ref":"payment_success_rate","aliases":["支付成功率","付款成功率","支付转化"],"related_tables":["payments"],"required_docs":["rule.payment_attempt_time"],"priority":87,"metadata":{"time_column":"payments.attempted_at","formula":"成功支付尝试数 / 全部支付尝试数"},"content":"默认支付成功率按支付尝试行计算：SUCCEEDED 尝试数除以全部尝试数，时间使用 attempted_at。若问订单级支付成功率，应以不同 order_id 为分母并明确口径。"},
  {"id":"metric.refund_amount_rate","kind":"metric","object_ref":"refund_amount_rate","aliases":["退款金额率","金额退款率","退款占比"],"related_tables":["payments","refunds"],"required_docs":["rule.refund_status","join.payment_refunds_safe"],"priority":92,"metadata":{"formula":"approved refund amount / successful payment amount"},"content":"退款金额率默认以所选支付订单的已批准退款金额除以成功支付金额。分子分母应分别按订单聚合，避免多笔支付与多笔退款形成乘法。"},
  {"id":"metric.refund_order_rate","kind":"metric","object_ref":"refund_order_rate","aliases":["退款订单率","退单率","发生退款的订单占比"],"related_tables":["payments","refunds"],"required_docs":["rule.refund_status"],"priority":90,"metadata":{"formula":"有 approved refund 的不同订单数 / 成功支付订单数"},"content":"退款订单率按不同订单计数，分子是至少一笔 APPROVED 退款的订单，分母是成功支付订单。它不同于退款申请率。"},
  {"id":"metric.refund_item_rate","kind":"metric","object_ref":"refund_item_rate","aliases":["退货件数率","商品退款率","退款件数占比"],"related_tables":["refund_items","refunds","order_items","orders"],"required_docs":["join.refund_items","metric.units_sold"],"priority":88,"metadata":{"formula":"approved refund item quantity / units_sold"},"content":"退货件数率用已批准退款明细 quantity 除以销售件数。必须连接 refunds 并筛 APPROVED，不能直接汇总所有 refund_items。"},
  {"id":"metric.on_time_delivery_rate","kind":"metric","object_ref":"on_time_delivery_rate","aliases":["准时送达率","按时妥投率","履约准时率"],"related_tables":["shipments"],"required_docs":["rule.delivery_status"],"priority":89,"metadata":{"time_column":"shipments.delivered_at","formula":"准时 DELIVERED 包裹数 / DELIVERED 包裹数"},"content":"默认包裹级准时送达率：status='DELIVERED' 且 delivered_at<=promised_delivery_at 的包裹数，除以全部 DELIVERED 包裹数。若问订单级必须先按订单归并。"},
  {"id":"metric.average_fulfillment_hours","kind":"metric","object_ref":"average_fulfillment_hours","aliases":["平均发货时长","支付到发货耗时","履约时长"],"related_tables":["payments","shipments"],"required_docs":["join.payment_shipments","rule.delivery_status"],"priority":84,"metadata":{"formula":"AVG(shipped_at - first_successful_paid_at)"},"content":"支付到发货时长按订单第一笔成功支付时间到每个包裹 shipped_at 计算。若要求订单级平均，先取订单首个发货时间或明确使用最后一个包裹。"},
  {"id":"metric.session_conversion_rate","kind":"metric","object_ref":"session_conversion_rate","aliases":["会话转化率","访问转化率","下单转化率"],"related_tables":["web_sessions"],"required_docs":["rule.session_time"],"priority":90,"metadata":{"formula":"COUNT(converted_order_id) / COUNT(session_id)"},"content":"会话转化率以访问会话为分母，converted_order_id 非空的会话为分子，时间使用 session_started_at。它不是支付转化率。"},
  {"id":"metric.visitor_conversion_rate","kind":"metric","object_ref":"visitor_conversion_rate","aliases":["访客转化率","用户转化率","UV转化率"],"related_tables":["web_sessions"],"required_docs":["rule.session_time"],"priority":84,"metadata":{"formula":"有转化的已识别客户数 / 有会话的已识别客户数"},"content":"访客转化率默认只对 customer_id 非空的已识别访客按不同客户计数。匿名会话无法稳定去重；若需包含匿名访客，应说明缺少 visitor_id。"},
  {"id":"metric.roas","kind":"metric","object_ref":"roas","aliases":["ROAS","广告回报率","投放回报","营销投入产出"],"related_tables":["campaign_spend_daily","order_promotions","payments","campaigns"],"required_docs":["join.campaign_revenue_spend","rule.campaign_attribution"],"priority":94,"metadata":{"formula":"归因成功支付收入 / campaign spend"},"content":"ROAS 是归因给活动的成功支付收入除以活动投放费用。收入通过 order_promotions 归因；费用从 campaign_spend_daily 汇总。两边先按 campaign 聚合再连接。"},
  {"id":"metric.click_through_rate","kind":"metric","object_ref":"click_through_rate","aliases":["点击率","CTR","曝光点击率"],"related_tables":["campaign_spend_daily"],"priority":82,"metadata":{"formula":"SUM(clicks)/SUM(impressions)"},"content":"点击率 CTR 使用汇总点击数除以汇总曝光数，不能平均每天的点击率。使用 NULLIF 处理零曝光。"},
  {"id":"metric.cost_per_click","kind":"metric","object_ref":"cost_per_click","aliases":["点击成本","CPC","单次点击费用"],"related_tables":["campaign_spend_daily"],"priority":82,"metadata":{"formula":"SUM(spend_amount)/SUM(clicks)"},"content":"CPC 使用总投放费用除以总点击数，不能对每日 CPC 简单平均。"},
  {"id":"metric.member_penetration_rate","kind":"metric","object_ref":"member_penetration_rate","aliases":["会员渗透率","付费会员占比","高等级会员订单占比"],"related_tables":["orders"],"required_docs":["rule.membership_snapshot","metric.order_count"],"priority":88,"metadata":{"formula":"GOLD/PLATINUM/DIAMOND 有效订单数 / 全部有效订单数"},"content":"默认会员渗透率将 GOLD、PLATINUM、DIAMOND 订单视为会员订单，按下单时等级快照计数；STANDARD 作为普通会员不进入分子。"},
  {"id":"metric.membership_upgrade_count","kind":"metric","object_ref":"membership_upgrade_count","aliases":["会员升级人数","等级提升人数","升级会员数"],"related_tables":["customer_memberships","membership_tiers"],"required_docs":["join.membership_history"],"priority":88,"metadata":{"time_column":"customer_memberships.valid_from","formula":"当前记录 tier_rank 大于前一记录的不同客户数"},"content":"会员升级需按客户和 valid_from 排序，用 LAG 比较相邻记录的 tier_rank；首条入会记录不算升级。"}
]
